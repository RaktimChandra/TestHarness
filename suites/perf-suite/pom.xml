<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.raktimchandra.testharness</groupId>
        <artifactId>testharness-parent</artifactId>
        <version>1.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>perf-suite</artifactId>
    <name>Suites :: performance</name>
    <description>Gatling (Java DSL) performance smoke test of the booking flow with p95/p99 and error-rate gates.</description>

    <properties>
        <!-- -DskipTests skips the load test too (install -DskipTests must not run Gatling);
             -DskipPerf skips only it. Unset, ${skipTests} stays literal and reads as false. -->
        <skipPerf>${skipTests}</skipPerf>
        <!-- -Dperf.simulation=...CapacitySimulation for one level of tools/capacity.py -->
        <perf.simulation>io.github.raktimchandra.testharness.perf.BookingFlowSimulation</perf.simulation>
    </properties>

    <!-- Gatling 3.16 is built on Netty 4.2; the Spring Boot BOM imported by the parent pins 4.1,
         which fails at start-up with NoClassDefFoundError: io/netty/channel/IoHandle. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>4.2.18.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>suite-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gatling.highcharts</groupId>
            <artifactId>gatling-charts-highcharts</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.gatling</groupId>
                <artifactId>gatling-maven-plugin</artifactId>
                <configuration>
                    <simulationClass>${perf.simulation}</simulationClass>
                    <runMultipleSimulations>false</runMultipleSimulations>
                    <failOnError>true</failOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>perf-smoke</id>
                        <phase>integration-test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <skip>${skipPerf}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
