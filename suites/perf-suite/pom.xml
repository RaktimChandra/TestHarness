<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.raktimchandra.testharness</groupId>
        <artifactId>testharness-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>perf-suite</artifactId>
    <name>Suites :: performance</name>
    <description>Gatling (Java DSL) performance smoke test of the booking flow with p95/p99 and error-rate gates.</description>

    <properties>
        <skipPerf>false</skipPerf>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>suite-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gatling.highcharts</groupId>
            <artifactId>gatling-charts-highcharts</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.gatling</groupId>
                <artifactId>gatling-maven-plugin</artifactId>
                <configuration>
                    <simulationClass>io.github.raktimchandra.testharness.perf.BookingFlowSimulation</simulationClass>
                    <runMultipleSimulations>false</runMultipleSimulations>
                    <failOnError>true</failOnError>
                    <resultsFolder>${project.build.directory}/gatling</resultsFolder>
                </configuration>
                <executions>
                    <execution>
                        <id>perf-smoke</id>
                        <phase>integration-test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <skip>${skipPerf}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
