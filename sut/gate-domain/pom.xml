<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.raktimchandra.testharness</groupId>
        <artifactId>testharness-parent</artifactId>
        <version>1.2.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>gate-domain</artifactId>
    <name>SUT :: gate-domain</name>
    <description>Framework-free business rules of the Gate Appointment system (the mutation-testing target).</description>

    <properties>
        <!-- Raised after each round of mutant-killing tests; see RESULTS.md. -->
        <pit.threshold>95</pit.threshold>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Mutation testing:  mvnw -Pmutation verify -pl sut/gate-domain
          Report: sut/gate-domain/target/pit-reports/index.html (and mutations.xml).
          The build fails if the mutation score drops below the threshold.
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <executions>
                            <execution>
                                <id>pit</id>
                                <phase>verify</phase>
                                <goals><goal>mutationCoverage</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <targetClasses>
                                <param>io.github.raktimchandra.gate.domain.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.github.raktimchandra.gate.domain.*</param>
                            </targetTests>
                            <mutators>
                                <mutator>STRONGER</mutator>
                            </mutators>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                                <outputFormat>XML</outputFormat>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <threads>2</threads>
                            <mutationThreshold>${pit.threshold}</mutationThreshold>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
